# Copy to .env and fill in only what you need. Never commit .env.

# Local server that serves the SciCheck adapters (see scripts/serve_vllm.sh).
# Port 18081 for the Llama adapter, 18082 for the Qwen adapter.
SCICHECK_API_BASE=http://127.0.0.1:18081/v1

# Together AI: only for the hosted Llama 3.1 8B base model
TOGETHERAI_API_KEY=

# Google AI Studio: Gemini 2.5 Flash (baseline and teacher model)
GOOGLE_API_KEY=

# Hugging Face Inference Providers: Qwen 2.5 14B base model
HF_API_KEY=

# Tavily: web evidence retrieval (data_preparation/02_web_search_tavily.py)
TAVILY_API_KEY=

# Optional: MLflow tracking server (default: file://$HOME/mlruns)
# MLFLOW_TRACKING_URI=
